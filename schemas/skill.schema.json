{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/withhull/hull-marketplace/main/schemas/skill.schema.json",
  "title": "Hull marketplace skill (front matter of skills/<id>/SKILL.md)",
  "description": "The skill directory is packaged as an archive and installed as-is.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "metadata"],
  "properties": {
    "name": { "$ref": "common.schema.json#/$defs/slug" },
    "description": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "license": {
      "description": "License of the listed skill, as an SPDX expression or NOASSERTION.",
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "compatibility": { "type": "string" },
    "allowed-tools": {
      "description": "Tools the skill may use, as a space-separated string or a list.",
      "oneOf": [
        { "type": "string" },
        { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" } }
      ]
    },
    "requirements": { "$ref": "common.schema.json#/$defs/requirements" },
    "metadata": {
      "type": "object",
      "required": ["category"],
      "properties": {
        "category": { "$ref": "common.schema.json#/$defs/agentCategory" },
        "suggest_for": { "$ref": "common.schema.json#/$defs/suggestFor" },
        "source": {
          "description": "Where the skill was originally published.",
          "type": "object",
          "properties": {
            "repository": { "$ref": "common.schema.json#/$defs/httpsUrl" },
            "path": { "type": "string" }
          }
        }
      }
    }
  }
}
