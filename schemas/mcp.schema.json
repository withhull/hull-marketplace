{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/withhull/hull-marketplace/main/schemas/mcp.schema.json",
  "title": "Hull marketplace MCP server (mcps/<id>/MCP.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "author", "url", "category", "content"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/slug" },
    "name": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "description": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "author": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "authorUrl": { "$ref": "common.schema.json#/$defs/httpsUrl" },
    "url": {
      "description": "Source repository or homepage of the MCP server.",
      "$ref": "common.schema.json#/$defs/httpsUrl"
    },
    "category": { "$ref": "common.schema.json#/$defs/category" },
    "prerequisites": { "$ref": "common.schema.json#/$defs/prerequisites" },
    "parameters": {
      "description": "Values prompted at install time when content is a single configuration string.",
      "type": "array",
      "items": { "$ref": "#/$defs/parameter" }
    },
    "content": {
      "description": "Either one MCP server configuration as a JSON string, or a list of installation methods.",
      "oneOf": [
        { "$ref": "#/$defs/configString" },
        { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/installationMethod" } }
      ]
    },
    "skills": {
      "description": "Companion skills installed with this MCP server.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "content"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/slug" },
          "content": {
            "description": "HTTPS URL of the skill archive (.tar.gz).",
            "$ref": "common.schema.json#/$defs/httpsUrl"
          },
          "integrity": {
            "description": "SRI digest of the archive, such as sha256-<base64>.",
            "type": "string",
            "pattern": "^sha(256|384|512)-[A-Za-z0-9+/]+={0,2}$"
          }
        }
      }
    },
    "suggest_for": { "$ref": "common.schema.json#/$defs/suggestFor" },
    "requirements": { "$ref": "common.schema.json#/$defs/requirements" }
  },
  "$defs": {
    "configString": {
      "description": "MCP server configuration as JSON. {{KEY}} placeholders are filled from parameters.",
      "type": "string",
      "minLength": 2
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "key"],
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "key": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "placeholder": { "type": "string" },
        "optional": { "type": "boolean" },
        "secret": { "type": "boolean" }
      }
    },
    "installationMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "content"],
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "description": { "type": "string" },
        "content": { "$ref": "#/$defs/configString" },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
        "prerequisites": { "$ref": "common.schema.json#/$defs/prerequisites" }
      }
    }
  }
}
